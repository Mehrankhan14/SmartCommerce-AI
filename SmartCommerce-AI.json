              "content": "=Customer Name: {{ $json.output.customer_name }}\nProduct: {{ $json.output.product }}\nQuantity: {{ $json.output.quantity }}\nSpecial Instructions: {{ $json.output.special_instructions }}\n\nGenerate an email asking for any missing required order details."
            }
